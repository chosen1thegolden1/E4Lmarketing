# Copy this file to ".env" (same folder) and paste your real token.
# The .env file is git-ignored and will NEVER be committed.

# Bot User OAuth Token from your Slack app (Install App page). Starts with xoxb-
SLACK_BOT_TOKEN=xoxb-your-token-here

# GoHighLevel Private Integration Token
# Sub-account > Settings > Private Integrations > Create new integration
GHL_API_TOKEN=pit-your-token-here
# Your sub-account (location) id — visible in the GHL URL or Settings > Business Info
GHL_LOCATION_ID=your-location-id-here
