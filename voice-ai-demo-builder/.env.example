# Copy to .env and fill in. Never commit .env.

# GoHighLevel — AI Employee / Voice AI
GHL_API_KEY=
GHL_LOCATION_ID=

# LLM used by the knowledge-base generator (one call, strict JSON schema)
LLM_API_KEY=

# Optional: path to a system Chromium for the Playwright fallback,
# for environments where Playwright's own browser download isn't available.
# CHROMIUM_PATH=/opt/pw-browsers/chromium
